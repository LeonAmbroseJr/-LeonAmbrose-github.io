        "import rasterio\n",
        "from rasterio.windows import Window\n",
        "\n",
        "def process_spatial_image_with_rasterio(image_path, target_size=(20, 20)):\n",
        "    \"\"\"\n",
        "    Loads an image using rasterio, converts it to grayscale (if multi-band),\n",
        "    resizes it, and normalizes pixel values to 0-1.\n",
        "\n",
        "    Args:\n",
        "        image_path (str): Path to the image file.\n",
        "        target_size (tuple): Desired (width, height) for the output array.\n",
        "\n",
        "    Returns:\n",
        "        np.ndarray: Normalized numerical array of the image, or None if an error occurs.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        with rasterio.open(image_path) as src:\n",
        "            # Read the first band (assuming grayscale or taking one band for processing)\n",
        "            # If it's a multi-band image (e.g., RGB), we'll take the first band.\n",
        "            # For true grayscale conversion, more complex logic might be needed.\n",
        "            img_array = src.read(1) # Read the first band\n",
        "\n",
        "            # Resize the image array using a simple resampling (e.g., nearest neighbor or bilinear)\n",
        "            # We'll use Pillow's resize for simplicity in this case after reading with rasterio\n",
        "            # because rasterio's internal resampling is more complex for simple resizing.\n",
        "            img_pil = Image.fromarray(img_array)\n",
        "            img_resized_pil = img_pil.resize(target_size, Image.Resampling.BILINEAR)\n",
        "            img_resized = np.array(img_resized_pil)\n",
        "\n",
        "            # Normalize values to 0-1 range\n",
        "            if img_resized.max() > 0:\n",
        "                normalized_array = img_resized / img_resized.max()\n",
        "            else:\n",
        "                normalized_array = img_resized # All zeros\n",
        "\n",
        "            return normalized_array\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: Image file not found at {image_path}\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"An error occurred while processing {image_path} with rasterio: {e}\")\n",
        "        return None\n",
        "\n",
        "print(\"Defined 'process_spatial_image_with_rasterio' function.\")\n"
      ],
      "execution_count": null,
