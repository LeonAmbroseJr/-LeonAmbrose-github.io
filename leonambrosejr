        "if slope_matrix is not None and elevation_matrix is not None:\n",
        "    print(\"Successfully processed slope and elevation images into numerical matrices.\")\n",
        "    print(f\"Slope matrix shape: {slope_matrix.shape}\")\n",
        "    print(f\"Elevation matrix shape: {elevation_matrix.shape}\")\n",
        "else:\n",
        "    print(\"Could not process one or both spatial layers. Correlation analysis aborted.\")\n"
      ],
