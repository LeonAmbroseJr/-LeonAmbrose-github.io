        "from PIL import Image\n",
        "\n",
        "def process_spatial_image(image_path, target_size=(20, 20)):\n",
        "    \"\"\"\n",
        "    Loads an image, converts it to grayscale, resizes it, and normalizes pixel values to 0-1.\n",
        "    \"\"\"\n",
        "    try:\n",
        "        img = Image.open(image_path).convert('L')  # Convert to grayscale\n",
        "        img_resized = img.resize(target_size)      # Resize to match habitat matrix\n",
        "        img_array = np.array(img_resized)           # Convert to numpy array\n",
        "        # Normalize values to 0-1 range\n",
        "        normalized_array = img_array / 255.0 if img_array.max() > 0 else img_array\n",
        "        return normalized_array\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: Image file not found at {image_path}\")\n",
        "        return None\n",
        "    except Exception as e:\n",
        "        print(f\"An error occurred while processing {image_path}: {e}\")\n",
        "        return None\n",
        "\n",
        "# Process the slope and elevation images\n",
        "slope_matrix = process_spatial_image('/content/slopemap1.png')\n",
        "elevation_matrix = process_spatial_image('/content/elevatedtinted.png')\n",
