    {
      "cell_type": "markdown",
      "metadata": {
        "id": "fdd86565"
      },
      "source": [
        "### Analyzing 'Dark, brooding, moody' progression: `i – VI – i – VII` in A Minor"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "20b23f00"
      },
      "source": [
        "engine = MusicTheoryEngine()\n",
        "# Analyze the 'Dark, brooding, moody' progression in A Minor\n",
        "engine.generate_progression_analysis(\"A\", [\"i\", \"VI\", \"i\", \"VII\"], key_type=\"Minor\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "746500ea"
      },
      "source": [
        "### Mood Chart Progressions Dictionary\n",
        "\n",
        "This dictionary maps various moods to a list containing the root key, a list of Roman numerals for the progression, and the key type. You can extend this with more entries from your chart."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "8df1a059"
      },
      "source": [
        "# Define a dictionary of mood-based chord progressions\n",
        "mood_progressions = {\n",
        "    'Dark, brooding, moody': {\n",
        "        'key': 'A',\n",
        "        'progression': ['i', 'VI', 'i', 'VII'],\n",
        "        'key_type': 'Minor'\n",
        "    },\n",
        "    'Sad, melancholic': {\n",
        "        'key': 'C',\n",
        "        'progression': ['i', 'iv', 'VII', 'i'],\n",
        "        'key_type': 'Minor'\n",
        "    },\n",
        "    'Hopeful, reflective': {\n",
        "        'key': 'D',\n",
        "        'progression': ['i', 'VI', 'III', 'VII'],\n",
        "        'key_type': 'Minor'\n",
        "    },\n",
        "    'Dramatic, intense': {\n",
        "        'key': 'E',\n",
        "        'progression': ['i', 'iv', 'v', 'i'],\n",
        "        'key_type': 'Minor'\n",
        "    }\n",
        "}\n",
        "\n",
        "print(\"Defined mood_progressions dictionary.\")\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "19fa9972"
      },
      "source": [
        "### Analyze Multiple Progressions from the Mood Chart\n",
        "\n",
        "Now, let's iterate through the `mood_progressions` dictionary and use the `MusicTheoryEngine` to analyze each one. This demonstrates how you can programmatically analyze different progressions without manual input for each."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "869538cd"
      },
      "source": [
        "import io\n",
        "import contextlib\n",
        "import pandas as pd\n",
        "import re\n",
        "import ast # Used for safely evaluating string representations of lists\n",
        "\n",
        "engine = MusicTheoryEngine()\n",
        "\n",
        "structured_analysis_data = []\n",
        "\n",
        "for mood_name, details in mood_progressions.items():\n",
        "    root_key = details['key']\n",
        "    progression_list = details['progression']\n",
        "    key_type = details['key_type']\n",
        "\n",
        "    # Capture the print output for the current analysis\n",
        "    with io.StringIO() as buf, contextlib.redirect_stdout(buf):\n",
        "        engine.generate_progression_analysis(root_key, progression_list, key_type=key_type)\n",
        "        output = buf.getvalue()\n",
        "\n",
        "    # --- Extract general progression info from the output string ---\n",
        "    key_in_output = \"N/A\"\n",
        "    key_match = re.search(r\"Harmonizing in the Key of (.*?)\\n\", output)\n",
        "    if key_match:\n",
        "        key_in_output = key_match.group(1).strip()\n",
        "\n",
        "    parent_scale_notes = []\n",
        "    parent_scale_match = re.search(r\"Parent Scale Notes: \\[(.*?)\\]\", output)\n",
        "    if parent_scale_match:\n",
        "        parent_scale_notes_str = parent_scale_match.group(1)\n",
        "        try:\n",
        "            # Safely convert string representation of list to actual list\n",
        "            parent_scale_notes = [note.strip(\" '\") for note in parent_scale_notes_str.split(',')]\n",
        "        except Exception:\n",
        "            pass # Keep as empty list if parsing fails\n",
        "\n",
        "    relative_key_info = \"N/A\"\n",
        "    relative_key_match = re.search(r\"(Relative (Minor|Major) Key: .*?)\\n\", output)\n",
        "    if relative_key_match:\n",
        "        relative_key_info = relative_key_match.group(1).strip()\n",
        "\n",
        "    progression_display_str = \"N/A\"\n",
        "    progression_display_str_match = re.search(r\"Chord Progression: (.*?)\\n\", output)\n",
        "    if progression_display_str_match:\n",
        "        progression_display_str = progression_display_str_match.group(1).strip()\n",
        "\n",
        "    # --- Parse individual chord details ---\n",
        "    lines = output.split('\\n')\n",
        "    for i in range(len(lines)):\n",
        "        line = lines[i]\n",
        "        if \"Numeral:\" in line:\n",
        "            # Initialize with default/error values\n",
        "            numeral = \"N/A\"\n",
        "            role = \"N/A\"\n",
        "            chord_name = \"N/A\"\n",
        "            chord_notes = []\n",
        "            solo_scale_name = \"N/A\"\n",
        "            solo_scale_notes = []\n",
        "            error_message = None\n",
        "\n",
        "            # Check if this is an error line for a numeral\n",
        "            error_line_match = re.search(r\"Numeral:\\s*([^|]+)\\s*\\|\\s*Error:\\s*(.*)\", line)\n",
        "            if error_line_match:\n",
        "                numeral = error_line_match.group(1).strip()\n",
        "                error_message = error_line_match.group(2).strip()\n",
        "                role = \"ERROR\"\n",
        "                chord_name = \"ERROR\"\n",
        "                solo_scale_name = \"ERROR\"\n",
        "            else:\n",
        "                # Parse regular chord line\n",
        "                numeral_match = re.search(r\"Numeral:\\s*([^|]+)\", line)\n",
        "                role_match = re.search(r\"Role:\\s*([^|]+)\", line)\n",
        "                chord_name_match = re.search(r\"Chord:\\s*([^|]+)\", line)\n",
        "                notes_match = re.search(r\"Notes:\\s*(\\[.*?\\])\", line)\n",
        "\n",
        "                if numeral_match: numeral = numeral_match.group(1).strip()\n",
        "                if role_match: role = role_match.group(1).strip()\n",
        "                if chord_name_match: chord_name = chord_name_match.group(1).strip()\n",
        "                if notes_match:\n",
        "                    try:\n",
        "                        chord_notes = ast.literal_eval(notes_match.group(1))\n",
        "                    except (SyntaxError, ValueError):\n",
        "                        chord_notes = [notes_match.group(1)] # Fallback if eval fails\n",
        "\n",
        "                # Check for solo scale line, which is usually the next line\n",
        "                if i + 1 < len(lines) and \"-> Solo Scale Option:\" in lines[i+1]:\n",
        "                    solo_line = lines[i+1]\n",
        "                    solo_scale_match = re.search(r\"Solo Scale Option:\\s*(.*?)\\s*(\\[.*?\\])\", solo_line)\n",
        "                    if solo_scale_match:\n",
        "                        solo_scale_name = solo_scale_match.group(1).strip()\n",
        "                        try:\n",
        "                            solo_scale_notes = ast.literal_eval(solo_scale_match.group(2))\n",
        "                        except (SyntaxError, ValueError):\n",
        "                            solo_scale_notes = [solo_scale_match.group(2)] # Fallback if eval fails\n",
        "\n",
        "            structured_analysis_data.append({\n",
        "                'Mood': mood_name,\n",
        "                'Key': key_in_output,\n",
        "                'Key Type (Input)': key_type,\n",
        "                'Full Progression': progression_display_str,\n",
        "                'Parent Scale Notes': parent_scale_notes,\n",
        "                'Relative Key Info': relative_key_info,\n",
        "                'Chord Numeral': numeral,\n",
        "                'Role': role,\n",
        "                'Chord Name': chord_name,\n",
        "                'Chord Notes': chord_notes,\n",
        "                'Solo Scale Name': solo_scale_name,\n",
        "                'Solo Scale Notes': solo_scale_notes,\n",
        "                'Error Message': error_message\n",
        "            })\n",
        "\n",
        "df_analysis_results = pd.DataFrame(structured_analysis_data)\n",
        "display(df_analysis_results)\n"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "84a5657a"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Count the occurrences of each chord name\n",
        "chord_distribution = df_analysis_results['Chord Name'].value_counts()\n",
        "\n",
        "# Create a bar plot for chord distribution\n",
        "fig = plt.figure(figsize=(12, 6))\n",
        "sns.barplot(x=chord_distribution.index, y=chord_distribution.values, palette='viridis')\n",
        "plt.title('Distribution of Chord Names Across All Analyzed Moods')\n",
        "plt.xlabel('Chord Name')\n",
        "plt.ylabel('Frequency')\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "execution_count": null,
      "outputs": []
    }
  ]
}